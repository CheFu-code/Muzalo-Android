{
    "expo": {
        "name": "Muzalo",
        "slug": "Muzalo",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "music-player",
        "userInterfaceStyle": "dark",
        "androidStatusBar": {
            "barStyle": "light-content",
            "backgroundColor": "#000000"
        },
        "newArchEnabled": false,
        "ios": {
            "supportsTablet": true,
            "infoPlist": {
                "UIBackgroundModes": ["audio", "audio"]
            }
        },
        "android": {
            "permissions": [
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "INTERNET",
                "MODIFY_AUDIO_SETTINGS",
                "WAKE_LOCK",
                "FOREGROUND_SERVICE",
                "android.permission.RECORD_AUDIO",
                "android.permission.MODIFY_AUDIO_SETTINGS",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "INTERNET",
                "MODIFY_AUDIO_SETTINGS",
                "WAKE_LOCK",
                "FOREGROUND_SERVICE",
                "android.permission.RECORD_AUDIO",
                "android.permission.MODIFY_AUDIO_SETTINGS"
            ],
            "package": "co.za.chefu.muzalo",
            "versionCode": 1,
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#000000"
            },
            "edgeToEdgeEnabled": true
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            [
                "expo-navigation-bar",
                {
                    "position": "absolute",
                    "visibility": "visible",
                    "behavior": "inset-swipe",
                    "backgroundColor": "#000000"
                }
            ],
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#000000"
                }
            ],
            "expo-audio",
            "react-native-edge-to-edge",
            "expo-sqlite",
            "./plugins/withMusicWidget"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "expo-navigation-bar": {
                "position": "absolute",
                "visibility": "visible",
                "behavior": "inset-swipe",
                "backgroundColor": "#000000"
            },
            "eas": {
                "projectId": "e665d300-e816-431d-91a5-4dd99b4022e3"
            }
        },
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/e665d300-e816-431d-91a5-4dd99b4022e3"
        }
    }
}
